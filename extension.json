{
	"name": "CommunityConfigurationExample",
	"author": [
		"Sergio Gimeno"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:TBD",
	"descriptionmsg": "communityconfigurationexample-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0",
		"extensions": {
			"CommunityConfiguration": "*"
		}
	},
	"attributes": {
		"CommunityConfiguration": {
			"Controls": {
				"CommunityConfigurationExample.StaticControl": {
					"module": "ext.communityConfigurationExample.staticControl",
					"component": "StaticControl"
				}
			},
			"Providers": {
				"CommunityConfigurationExample": {
					"store": {
						"type": "wikipage",
						"args": [
							"MediaWiki:CommunityConfigurationExample.json"
						]
					},
					"validator": {
						"type": "jsonschema",
						"args": [
							"MediaWiki\\Extension\\CommunityConfigurationExample\\Config\\Schemas\\ExampleSchema"
						]
					},
					"type": "mw-config"
				}
			}
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\CommunityConfigurationExample\\": "src/"
	},
	"MessagesDirs": {
		"CommunityConfigurationExample": [
			"i18n"
		]
	},
	"TranslationAliasesDirs": {
		"CommunityConfigurationExample": "i18n/alias"
	},
	"SpecialPages": {
		"CommunityConfigurationExample": {
			"class": "MediaWiki\\Extension\\CommunityConfigurationExample\\Specials\\SpecialCommunityConfigurationExample",
			"services": [
				"CommunityConfiguration.MediaWikiConfigReader"
			]
		}
	},
	"ResourceModules": {
		"ext.communityConfigurationExample.staticControl": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [ "CdxLabel" ],
			"localBasePath": "modules/ext.communityConfigurationExample.staticControl",
			"remoteExtPath": "CommunityConfigurationExample/modules/ext.communityConfigurationExample.staticControl",
			"packageFiles": [
				"index.js",
				"StaticControl.vue"
			],
			"dependencies": [
				"vue",
				"ext.communityConfiguration.Editor.controls"
			]
		}
	},
	"manifest_version": 2
}
